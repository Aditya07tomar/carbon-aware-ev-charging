# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=carbon_ev_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=carbon_ev_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── FastAPI ─────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=replace-with-a-secure-random-string

# ── WattTime API ────────────────────────────────────────────
WATTTIME_USERNAME=your_watttime_username
WATTTIME_PASSWORD=your_watttime_password

# ── Smartcar API ────────────────────────────────────────────
SMARTCAR_CLIENT_ID=your_smartcar_client_id
SMARTCAR_CLIENT_SECRET=your_smartcar_client_secret
SMARTCAR_REDIRECT_URI=http://localhost:8000/auth/smartcar/callback

# ── Encryption ──────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-fernet-key
